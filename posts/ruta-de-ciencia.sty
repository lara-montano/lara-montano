%% =====================================================================
%%  ruta-de-ciencia.sty  —  Tema de carrusel de Instagram para
%%  "Ruta de Ciencia"  ·  Ciencia con sentido crítico.
%%
%%  Lienzo: 1080 x 1350 px (formato vertical 4:5 de Instagram).
%%  Compilar con:  pdflatex  (NO xelatex).
%%  Exportar a PNG:  pdftoppm -scale-to-x 1080 -png post.pdf out/slide
%%
%%  Diseñado para reutilizarse en TODOS los posts: cada publicación
%%  solo cambia el contenido, no el estilo.
%% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ruta-de-ciencia}[2026/07/14 v1.0 Ruta de Ciencia — tema de carrusel Instagram]

% ---- Lienzo Instagram 4:5 (1080x1350 px @ 100 px/cm) ----------------
\geometry{paperwidth=10.8cm,paperheight=13.5cm}

% ---- Paquetes -------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[defaultfam,medium,tabular,lining]{montserrat} % fuente marca
\RequirePackage{anyfontsize}
\RequirePackage{tikz}
\usetikzlibrary{calc,positioning,fadings}
\RequirePackage{fontawesome5}

% ---- Paleta de marca ------------------------------------------------
\definecolor{rdcbg}{HTML}{0C1B2A}      % fondo azul noche
\definecolor{rdcbgsoft}{HTML}{13293D}  % panel
\definecolor{rdcink}{HTML}{F4F8FB}     % texto principal
\definecolor{rdcbody}{HTML}{C9D6E3}    % texto de cuerpo
\definecolor{rdcmuted}{HTML}{7E93A8}   % texto tenue
\definecolor{rdccyan}{HTML}{2DD4BF}    % acento marca / verdad
\definecolor{rdcred}{HTML}{FF6B6B}     % mito / alerta
\definecolor{rdcamber}{HTML}{FFC857}   % resaltado

% ---- Pesos de Montserrat (atajos) -----------------------------------
\newcommand{\wblack}{\fontseries{black}\selectfont}
\newcommand{\wextrabold}{\fontseries{extrabold}\selectfont}
\newcommand{\wsemibold}{\fontseries{semibold}\selectfont}
\newcommand{\wlight}{\fontseries{light}\selectfont}
\newcommand{\wregular}{\fontseries{regular}\selectfont}

% ---- Metadatos del post (redefinir en cada .tex) --------------------
\newcommand{\rdchandle}{@rutadeciencia}
\newcommand{\rdccategory}{MITO vs.\ EVIDENCIA}
\newcommand{\rdctotalslides}{8}
% color de acento de la categoría (se puede cambiar por post)
\newcommand{\rdcaccent}{rdccyan}

% ---- Beamer base ----------------------------------------------------
\setbeamertemplate{navigation symbols}{}
\setbeamercolor{background canvas}{bg=rdcbg}
\setbeamercolor{normal text}{fg=rdcink}
\usebeamercolor[fg]{normal text}
\setbeamerfont{normal text}{family=\sffamily}

% ====================================================================
%  Helpers internos
% ====================================================================
% Fondo + motivo "radar" tenue (sensación científica)
\newcommand{\rdc@bg}{%
  \fill[rdcbg] (current page.south west) rectangle (current page.north east);
  \begin{scope}
    \clip (current page.south west) rectangle (current page.north east);
    \foreach \r in {1.3,2.4,3.5,4.6,5.7}{%
      \draw[rdccyan,opacity=0.045,line width=1.1pt]
        ([shift={(0.15,0.35)}]current page.north east) circle (\r);}
  \end{scope}
}

% Cromo compartido: marca arriba, pie + barra de progreso abajo.
% #1 = número de lámina actual
\newcommand{\rdc@chrome}[1]{%
  % --- marca arriba-izquierda ---
  \node[anchor=north west,text=rdcink,font=\wsemibold\fontsize{9}{9}\selectfont]
    at ([shift={(0.9,-0.82)}]current page.north west)
    {\textcolor{rdccyan}{\faCompass}\hspace{4pt}RUTA DE CIENCIA};
  % --- etiqueta de categoría arriba-derecha ---
  \node[anchor=north east,inner xsep=9pt,inner ysep=5pt,rounded corners=8pt,
        draw=\rdcaccent,line width=1pt,text=\rdcaccent,
        font=\wsemibold\fontsize{8}{8}\selectfont]
    at ([shift={(-0.9,-0.72)}]current page.north east) {\rdccategory};
  % --- pie: handle ---
  \node[anchor=south west,text=rdcmuted,font=\wregular\fontsize{8.5}{8.5}\selectfont]
    at ([shift={(0.9,0.62)}]current page.south west) {\rdchandle};
  % --- pie: contador ---
  \node[anchor=south east,text=rdcmuted,font=\wsemibold\fontsize{8.5}{8.5}\selectfont]
    at ([shift={(-0.9,0.62)}]current page.south east)
    {\textcolor{rdcink}{#1}\,/\,\rdctotalslides};
  % --- barra de progreso ---
  \draw[rdcbgsoft,line width=2.4pt,line cap=round]
    ([shift={(0.9,0.42)}]current page.south west) --
    ([shift={(-0.9,0.42)}]current page.south east);
  \draw[rdccyan,line width=2.4pt,line cap=round]
    ([shift={(0.9,0.42)}]current page.south west) --
    ([shift={($(0.9,0.42)+(#1*9/\rdctotalslides,0)$)}]current page.south west);
}

% Ancla superior del área de contenido
\newcommand{\rdc@top}{([shift={(0.9,-2.55)}]current page.north west)}

% Evita partir palabras con guion en los titulares.
% \hyphenchar\font=-1 quita el guion de la fuente activa (a prueba de balas
% dentro de nodos TikZ); se refuerza con penalizaciones altas.
\newcommand{\rdc@nohyphen}{\hyphenchar\font=-1\hyphenpenalty=10000\exhyphenpenalty=10000\relax}

% ====================================================================
%  LÁMINAS DE ALTO NIVEL  (usar en el .tex)
% ====================================================================

% ---- Portada -------------------------------------------------------
% \rdccover{PALABRA-SELLO}{TÍTULO GRANDE}{subtítulo}
\newcommand{\rdccover}[3]{%
\begin{frame}[plain]
\begin{tikzpicture}[remember picture,overlay]
  \rdc@bg
  \rdc@chrome{1}
  % gancho / kicker
  \node[anchor=north west,text=rdccyan,font=\wsemibold\fontsize{11}{11}\selectfont]
    at ([shift={(0.9,-3.0)}]current page.north west) {DESLIZA PARA DESCUBRIR \faArrowRight};
  % título grande
  \node[anchor=north west,text width=9cm,align=left,text=rdcink,
        font=\wblack\fontsize{31}{35}\selectfont]
    (title) at ([shift={(0.9,-3.7)}]current page.north west) {#2};
  % sello (MITO) rotado — en el hueco central, sin chocar con el texto
  \node[rotate=-7,anchor=center,draw=rdcred,line width=2.2pt,rounded corners=4pt,
        inner xsep=12pt,inner ysep=7pt,text=rdcred,
        font=\wblack\fontsize{25}{25}\selectfont]
    at ([shift={(6.9,4.95)}]current page.south west) {#1};
  % subtítulo
  \node[anchor=south west,text width=9cm,align=left,text=rdcbody,
        font=\wregular\fontsize{12.5}{17}\selectfont]
    at ([shift={(0.9,1.55)}]current page.south west) {\rdc@nohyphen #3};
\end{tikzpicture}
\end{frame}}

% ---- Lámina de contenido ------------------------------------------
% \rdccontent{núm}{\faIcono}{ETIQUETA}{TITULAR}{cuerpo}
\newcommand{\rdccontent}[5]{%
\begin{frame}[plain]
\begin{tikzpicture}[remember picture,overlay]
  \rdc@bg
  \rdc@chrome{#1}
  % badge con icono
  \node[anchor=north west,minimum size=0.95cm,rounded corners=10pt,
        fill=rdcbgsoft,text=rdccyan,font=\fontsize{19}{19}\selectfont]
    (badge) at \rdc@top {#2};
  % etiqueta
  \node[anchor=north west,text=rdccyan,font=\wsemibold\fontsize{11}{11}\selectfont]
    (kick) at ([shift={(0.28,-0.16)}]badge.north east) {#3};
  % titular
  \node[anchor=north west,text width=9cm,align=left,text=rdcink,
        font=\wblack\fontsize{22}{26}\selectfont]
    (head) at ([yshift=-0.55cm]badge.south west) {\rdc@nohyphen #4};
  % cuerpo
  \node[anchor=north west,text width=9cm,align=left,text=rdcbody,
        font=\wregular\fontsize{13.5}{20}\selectfont]
    at ([yshift=-0.45cm]head.south west) {\rdc@nohyphen #5};
\end{tikzpicture}
\end{frame}}

% ---- Lámina de cierre / veredicto ---------------------------------
% \rdcclosing{núm}{VEREDICTO}{cuerpo}{fuente}
\newcommand{\rdcclosing}[4]{%
\begin{frame}[plain]
\begin{tikzpicture}[remember picture,overlay]
  \rdc@bg
  \rdc@chrome{#1}
  % sello REALIDAD
  \node[anchor=north west,inner xsep=10pt,inner ysep=5pt,rounded corners=6pt,
        fill=rdccyan,text=rdcbg,font=\wblack\fontsize{12}{12}\selectfont]
    (seal) at \rdc@top {\faCheckCircle\ \ REALIDAD};
  % veredicto grande
  \node[anchor=north west,text width=9cm,align=left,text=rdcink,
        font=\wblack\fontsize{21}{25}\selectfont]
    (head) at ([yshift=-0.5cm]seal.south west) {\rdc@nohyphen #2};
  % cuerpo
  \node[anchor=north west,text width=9cm,align=left,text=rdcbody,
        font=\wregular\fontsize{12.5}{18}\selectfont]
    (body) at ([yshift=-0.4cm]head.south west) {\rdc@nohyphen #3};
  % fuente
  \node[anchor=south west,text width=9cm,align=left,text=rdcmuted,
        font=\wlight\fontsize{9}{12.5}\selectfont]
    at ([shift={(0.9,2.5)}]current page.south west) {\faBookOpen\ \ #4};
  % CTA (una sola línea de chips)
  \node[anchor=south west,text=rdccyan,
        font=\wsemibold\fontsize{11}{11}\selectfont]
    at ([shift={(0.9,1.55)}]current page.south west)
    {\faBookmark\ Guarda\ \ \raisebox{0.2ex}{\textcolor{rdcmuted}{\textbullet}}\ \ \faShareSquare\ Comparte\ \ \raisebox{0.2ex}{\textcolor{rdcmuted}{\textbullet}}\ \ \faComment[regular]\ Comenta};
\end{tikzpicture}
\end{frame}}

% ---- Lámina de CIERRE de crecimiento / SÍGUENOS -------------------
% Optimizada para convertir a nuevos seguidores.
% \rdcfollow{núm}{TITULAR}{motivo para seguir}{gancho de etiquetar}
\newcommand{\rdcfollow}[4]{%
\begin{frame}[plain]
\begin{tikzpicture}[remember picture,overlay]
  \rdc@bg
  \rdc@chrome{#1}
  % logo (anclado desde arriba para posición predecible)
  \node[circle,fill=rdccyan,minimum size=1.5cm,inner sep=0pt,text=rdcbg,
        font=\fontsize{30}{30}\selectfont] (logo)
    at ([shift={(0,-2.9)}]current page.north) {\faCompass};
  % propuesta de valor
  \node[below=0.28cm of logo,text=rdcmuted,font=\wsemibold\fontsize{10.5}{10.5}\selectfont]
    (vp) {CIENCIA CON SENTIDO CRÍTICO};
  % titular
  \node[below=0.42cm of vp,text width=9.2cm,align=center,text=rdcink,
        font=\wblack\fontsize{25}{29}\selectfont] (head) {\rdc@nohyphen #2};
  % motivo
  \node[below=0.3cm of head,text width=8.6cm,align=center,text=rdcbody,
        font=\wregular\fontsize{13}{18}\selectfont] (reason) {\rdc@nohyphen #3};
  % botón/píldora de seguir
  \node[below=0.55cm of reason,inner xsep=18pt,inner ysep=10pt,rounded corners=16pt,
        fill=rdccyan,text=rdcbg,font=\wblack\fontsize{15}{15}\selectfont] (pill)
    {\faUserPlus\ \ Sigue \rdchandle};
  % gancho de etiquetar
  \node[below=0.5cm of pill,text width=8.6cm,align=center,text=rdcmuted,
        font=\wregular\fontsize{11}{15}\selectfont] {\rdc@nohyphen #4};
\end{tikzpicture}
\end{frame}}

\endinput
